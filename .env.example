# Общие
NODE_ENV=development
# Логическое окружение deployment; на staging задаётся отдельно от NODE_ENV.
DEPLOYMENT_ENVIRONMENT=development

# PostgreSQL (docker compose + API)
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform
POSTGRES_DB=platform
POSTGRES_PORT=5432
DATABASE_URL=postgresql://platform:platform@localhost:5432/platform?schema=public

# API
API_PORT=3001
API_HOST=0.0.0.0
# Список origins через запятую
CORS_ORIGINS=http://localhost:3000
COMMIT_SHA=local-dev
APP_VERSION=0.0.0
LOG_LEVEL=info
# Необязательная backend telemetry. Реальные endpoint и auth headers хранятся только в Fly Secrets.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# Web (публичные переменные Next.js)
# Локально — URL локального API.
# Vercel Preview: создать ту же переменную в Environment Variables → Preview
# без реального staging API URL (значение появится после деплоя API).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
# Публичный collector URL из Grafana Frontend Observability; пустое значение отключает Faro локально.
NEXT_PUBLIC_FARO_URL=
NEXT_PUBLIC_DEPLOYMENT_ENVIRONMENT=development
# В Vercel значение автоматически берётся из VERCEL_GIT_COMMIT_SHA.
NEXT_PUBLIC_COMMIT_SHA=local-dev

# Build-time конфигурация приватной загрузки sourcemaps в Grafana Cloud.
# Реальные значения задаются только в Vercel и не попадают в browser bundle.
FARO_SOURCEMAP_API_URL=
FARO_APP_ID=
FARO_API_KEY=
FARO_STACK_ID=
