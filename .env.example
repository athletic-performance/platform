# Общие
NODE_ENV=development

# PostgreSQL (docker compose + API)
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform
POSTGRES_DB=platform
POSTGRES_PORT=5432
DATABASE_URL=postgresql://platform:platform@localhost:5432/platform?schema=public

# API
API_PORT=3001
API_HOST=0.0.0.0
# Список origins через запятую
CORS_ORIGINS=http://localhost:3000
COMMIT_SHA=local-dev
APP_VERSION=0.0.0
LOG_LEVEL=info

# Web (публичные переменные Next.js)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
