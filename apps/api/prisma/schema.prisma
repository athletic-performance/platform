generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Техническая таблица foundation. Продуктовая схема намеренно отсутствует.
model TechFoundation {
  id        Int      @id @default(1)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("_tech_foundation")
}
